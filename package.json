{
  "name": "deckrypt",
  "version": "1.0.0",
  "private": true,
  "description": "Deck builder & analyse Magic: The Gathering. Vanilla JS, sans backend.",
  "scripts": {
    "dev": "http-server -p 8080 -c-1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "http-server": "^14.1.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.1.1"
}
